# Copy this file to  .env  (same folder) and fill in your values. NEVER share or upload the real .env file.

# ---------- general ----------
SECRET_KEY=change-me-to-a-long-random-text
FLASK_DEBUG=0
# set to 1 once the site runs on https (secure cookies)
HTTPS=0
# set to 1 when the site is behind nginx / a hosting platform proxy (so real visitor IPs are used)
BEHIND_PROXY=0

# ---------- database (MySQL) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=ganpati_shop_db
# GANPATI_DB=sqlite     (uncomment to force the simple local SQLite file)

# ---------- e-mail (welcome / login / password reset mails) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-letter-gmail-app-password
SMTP_FROM=Gajanan Kala Kendra <yourgmail@gmail.com>

# ---------- AI assistant ----------
# ollama     = free, runs on your own computer (good while developing)
# anthropic  = hosted Claude API (good for the live website)
# openai     = any OpenAI-compatible service (OpenAI, Groq, OpenRouter, ...)
AI_PROVIDER=ollama
AI_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
# for anthropic / openai:
AI_API_KEY=
# only for openai-compatible services (default is OpenAI):
AI_BASE_URL=https://api.openai.com/v1
# safety cap so a hosted AI can never run up a big bill (messages per day, whole site)
AI_DAILY_LIMIT=500
